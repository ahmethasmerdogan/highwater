# SARNIÇ — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve doldurun. .env repoya ASLA girmez.

# --- Ortam ---
SARNIC_ENV=dev
SARNIC_LOG_JSON=false

# --- Veritabanı / Redis (Docker içinde host adları kullanılır) ---
POSTGRES_PASSWORD=degistir-beni
SARNIC_DATABASE_URL=postgresql+asyncpg://sarnic:degistir-beni@localhost:5432/sarnic
SARNIC_REDIS_URL=redis://localhost:6379/0

# --- Kimlik doğrulama ---
# Üretimde mutlaka değiştirin: openssl rand -hex 32
SARNIC_JWT_SECRET=degistir-beni-bu-bir-sir-degil
# Entegrasyon sırlarını şifrelemek için Fernet anahtarı:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Boş bırakılırsa JWT sırrından türetilir (geliştirme için yeterli, prod için değil).
SARNIC_SECRET_ENCRYPTION_KEY=

# --- İlk yönetici (yalnızca boş veritabanında seed edilir) ---
SARNIC_BOOTSTRAP_ADMIN_EMAIL=admin@sarnic.local
# Boş bırakılırsa rastgele üretilir ve bir kez loglara yazılır.
SARNIC_BOOTSTRAP_ADMIN_PASSWORD=

# --- Binance ---
# Market data için anahtar GEREKMEZ. Aşağıdakiler yalnızca Faz 11'de,
# BinanceSpotAdapter açıldığında kullanılır. Çekim yetkisi KAPALI olmalı.
SARNIC_BINANCE_API_KEY=
SARNIC_BINANCE_API_SECRET=

# --- Paper motoru ---
SARNIC_PAPER_INITIAL_BALANCE=5000
SARNIC_PAPER_TAKER_FEE=0.001
SARNIC_PAPER_EXTRA_SLIPPAGE_BPS=5
SARNIC_PAPER_LATENCY_MS=250

# --- Panel ---
NEXT_PUBLIC_API_URL=http://localhost:8000
API_PORT=8000
WEB_PORT=3000

# --- Gözlemlenebilirlik ------------------------------------------------------
# Prometheus + Grafana:  docker compose --profile gozlem up -d
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=degistir-beni

# Sentry — boş bırakılırsa tamamen kapalıdır. sentry.io'dan (veya kendi
# kurulumunuzdan) aldığınız DSN'i buraya yapıştırın. Hata takibi için
# örnekleme oranına gerek yoktur; 1 saatlik karar döngüsünde performans izi
# bir şey anlatmaz, o yüzden traces varsayılan olarak kapalı.
SARNIC_SENTRY_DSN=
SARNIC_SENTRY_RELEASE=
SARNIC_SENTRY_TRACES_SAMPLE_RATE=0.0

# Arka plan servislerinin /metrics portları (0 = kapalı).
SARNIC_METRICS_PORT_MARKETDATA=9101
SARNIC_METRICS_PORT_SUPERVISOR=9102
SARNIC_METRICS_PORT_NOTIFIER=9103
# Worker portu = taban + bot_id
SARNIC_METRICS_PORT_WORKER_BASE=9110
